# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest for one
# block and fill when a real print crosses their price.
PRIVATE_KEY=
DRY_RUN=true

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100

# Kuru limit orders draw from the margin account, not the wallet. At startup the bot deposits enough to
# reach these balances. Asks need MON, bids need USDC. Proceeds of fills also land in margin.
MARGIN_MON=600
MARGIN_USDC=20
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

PORT=3000

# Position management (lab)
TP_BPS=8
SL_BPS=8
TIME_STOP_BLOCKS=150
ENTRY_MIN_PROB=0.15

# Reflexes: deterministic gates that run before the decision model and again before anything
# is signed. They never ask a model. Create the kill switch file to stop entries at once.
KILL_SWITCH_FILE=data/KILL
SESSION_LOSS_USD=5
MIN_LIQUIDITY_MON=1000
MAX_SPREAD_BPS=12
MIN_SCORE=25

# Quoting: reservation price + inventory skew + volatility-scaled half-spread.
# gamma is risk aversion (poly-maker runs 0.6); the half-spread floor and the
# liquidity term are in bps; MAX_DISTANCE_BPS is how far behind the touch we may sit.
MM_GAMMA=0.6
MM_LIQ_HALF_SPREAD_BPS=1.5
MM_MIN_HALF_SPREAD_BPS=0.5
MM_MAX_DISTANCE_BPS=3

# Sizing from depth: base size (the venue minimum) on a thin book, MAX_QUOTE_MON when
# the near-touch depth is at least DEEP_DEPTH_RATIO times the base size.
MAX_QUOTE_MON=400
DEEP_DEPTH_RATIO=100

# Flow toxicity: net over gross taker volume over the window. Above MAX_TOXICITY we
# stand down on the side the flow is running over; above MAX_TOXICITY_EXTREME (the
# tail: this tape is one-sided most of the time) every quote pauses.
FLOW_WINDOW_BLOCKS=300
FLOW_MIN_VOLUME_MON=10000
MAX_TOXICITY=0.7
MAX_TOXICITY_EXTREME=0.995

# Regime machine: a mid move of REGIME_JUMP_BPS inside the window is a jump, a print
# worth REGIME_SWEEP_RATIO of the base size is a sweep, both pause entries for
# REGIME_COOLOFF_BLOCKS and widen the half-spread. Calibrate the ratio to the tape.
REGIME_JUMP_BPS=15
REGIME_JUMP_WINDOW_BLOCKS=20
REGIME_SWEEP_RATIO=15
REGIME_COOLOFF_BLOCKS=60
REGIME_STRESS_SPREAD_MULT=2.5
REGIME_COOLOFF_SPREAD_MULT=1.6

# Maker decomposition: how many blocks after a fill the markout is measured.
MARKOUT_BLOCKS=100
# Blocks of OrderBook logs the boot recovery replays to find our resting orders.
RECOVERY_LOOKBACK_BLOCKS=10000
